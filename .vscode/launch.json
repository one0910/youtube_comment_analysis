{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django 偵錯",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "runserver",
                "8100",
                "--noreload"
            ],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}